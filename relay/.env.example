# Vercel env for the relay (set in the Vercel project, never commit real values).
RELAY_SECRET=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
MODEL_API_KEY=
BASETEN_API_KEY=
# Optional: BASETEN_MODEL (default meta-models/muse-spark-open-1026), RELAY_META_CHAT_MODEL (override chat body model on Meta).
RESEND_API_KEY=
# Comma-separated recipients /api/resend may send to. Unset = all refused.
ALLOWED_RECIPIENT=you@example.com
