# Copy to .env (never commit real values). Server reads these at runtime.

# Staff-decision emails (approve / reject / more info) all go to this one address.
# Unset = emails are kept in the outbox and not sent.
ONBOARDING_NOTIFY_EMAIL=you@example.com
EMAIL_FROM="Onboarding <onboarding@resend.dev>"
PUBLIC_BASE_URL=https://your-app.example.com

# Relay mode (keys live on the relay, the app holds only the shared secret)
RELAY_URL=https://your-relay.example.vercel.app
RELAY_SECRET=

# Direct mode (only if not using the relay)
RESEND_API_KEY=
MODEL_API_KEY=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
